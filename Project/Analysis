# %% [markdown]
# ## 15. Prosta strategia inwestycyjna MA20/MA50
#
# Testujemy bardzo prostą strategię:
#
# - kupujemy, gdy MA20 > MA50,
# - nie trzymamy akcji, gdy MA20 <= MA50.
#
# Jest to tylko przykład dydaktyczny, a nie rekomendacja inwestycyjna.

# %%
def moving_average_strategy(df: pd.DataFrame) -> pd.DataFrame:
    """
    Prosta strategia przecięcia średnich MA20 i MA50.
    """
    result = df.copy()

    result["Signal"] = 0
    result.loc[result["MA20"] > result["MA50"], "Signal"] = 1

    # Przesunięcie o jeden dzień usuwa błąd patrzenia w przyszłość.
    result["Position"] = result["Signal"].shift(1).fillna(0)

    result["Strategy_Return"] = result["Position"] * result["Return"]
    result["Strategy_Cumulative_Return"] = (1.0 + result["Strategy_Return"].fillna(0)).cumprod()

    return result


