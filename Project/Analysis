def download_stock_data(symbol: str, start: str, end: str | None = None) -> pd.DataFrame:
    """
    Pobiera dzienne dane giełdowe z Yahoo Finance przez yfinance.

    Parametry
    ---------
    symbol:
        Symbol Yahoo Finance, np. 'CDR.WA'.
    start:
        Data początkowa w formacie 'YYYY-MM-DD'.
    end:
        Data końcowa w formacie 'YYYY-MM-DD' albo None.

    Zwraca
    ------
    DataFrame z kolumnami:
    Date, Open, High, Low, Close, Adj Close, Volume, Symbol
    """
    df = yf.download(
        symbol,
        start=start,
        end=end,
        interval="1d",
        auto_adjust=False,
        progress=False,
    )

    if df.empty:
        raise ValueError(
            f"Nie udało się pobrać danych dla symbolu {symbol}. "
            "Sprawdź symbol w Yahoo Finance, np. CDR.WA dla CD Projekt."
        )

    # yfinance czasem zwraca MultiIndex przy nowszych wersjach.
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)

    df = df.reset_index()
    df["Symbol"] = symbol

    expected_columns = ["Date", "Open", "High", "Low", "Close", "Adj Close", "Volume", "Symbol"]
    available_columns = [col for col in expected_columns if col in df.columns]
    df = df[available_columns]

    df["Date"] = pd.to_datetime(df["Date"])
    df = df.sort_values("Date").reset_index(drop=True)

    return df


def add_indicators(df: pd.DataFrame) -> pd.DataFrame:
    """
    Dodaje podstawowe wskaźniki:
    - dzienną stopę zwrotu,
    - skumulowaną stopę zwrotu,
    - średnie kroczące,
    - zmienność kroczącą,
    - obsunięcie kapitału.
    """
    df = df.copy()

    df["Return"] = df["Close"].pct_change()
    df["Cumulative_Return"] = (1.0 + df["Return"]).cumprod()

    df["MA20"] = df["Close"].rolling(window=20).mean()
    df["MA50"] = df["Close"].rolling(window=50).mean()
    df["MA200"] = df["Close"].rolling(window=200).mean()

    df["Volatility_20"] = df["Return"].rolling(window=20).std() * np.sqrt(252)

    df["Running_Max"] = df["Cumulative_Return"].cummax()
    df["Drawdown"] = df["Cumulative_Return"] / df["Running_Max"] - 1.0

    return df


def calculate_summary(df: pd.DataFrame, company_name: str) -> dict:
    """
    Oblicza podstawowe statystyki dla jednej spółki.
    """
    returns = df["Return"].dropna()

    total_return = df["Cumulative_Return"].iloc[-1] - 1.0
    annual_return = (1.0 + total_return) ** (252 / len(df)) - 1.0
    annual_volatility = returns.std() * np.sqrt(252)

    if annual_volatility != 0:
        sharpe_ratio = annual_return / annual_volatility
    else:
        sharpe_ratio = np.nan

    max_drawdown = df["Drawdown"].min()

    return {
        "Spółka": company_name,
        "Symbol": df["Symbol"].iloc[0],
        "Liczba sesji": len(df),
        "Cena początkowa": df["Close"].iloc[0],
        "Cena końcowa": df["Close"].iloc[-1],
        "Stopa zwrotu całkowita": total_return,
        "Stopa zwrotu roczna": annual_return,
        "Zmienność roczna": annual_volatility,
        "Sharpe bez stopy wolnej od ryzyka": sharpe_ratio,
        "Maksymalne obsunięcie": max_drawdown,
    }


def save_plot(filename: str) -> None:
    """
    Zapisuje aktualny wykres do katalogu wynikowego.
    """
    path = OUTPUT_DIR / filename
    plt.tight_layout()
    plt.savefig(path, dpi=150)
    print(f"Zapisano wykres: {path}")


