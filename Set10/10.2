"""Exercise 10.2: pd.Series with daily USD/PLN exchange rates."""
import numpy as np
import pandas as pd

# Dzisiejsza data i określenie miesiąca
today = np.datetime64("today")
year, month = today.astype(object).year, today.astype(object).month

# Pierwszy i ostatni dzień bieżącego miesiąca
first_day = np.datetime64(f"{year}-{month:02d}-01")
if month == 12:
    next_month = np.datetime64(f"{year + 1}-01-01")
else:
    next_month = np.datetime64(f"{year}-{month + 1:02d}-01")
last_day = next_month - np.timedelta64(1, "D")

# Zakres dat
dates = np.arange(first_day, last_day + np.timedelta64(1, "D"),
                  dtype="datetime64[D]")

# Wygeneruj kursy (np. USD/PLN) – stałe ziarno dla powtarzalności
np.random.seed(123)
fx_rates = np.random.uniform(low=3.80, high=4.30, size=len(dates)).round(4)

# Utwórz serię
fx_series = pd.Series(data=fx_rates, index=dates, name="USD/PLN")
print(fx_series.head(10))
