import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# ========== PARAMETRY ==========
L = 1.0
alpha = 0.01
T_total = 5.0

Nx = 50
Nt = 5000

dx = L / (Nx - 1)
dt = T_total / Nt

# Sprawdzenie stabilności
r = alpha * dt / (dx**2)
print(f"r = {r:.3f} (wymagane ≤ 0.5 dla stabilności)")

# Siatka przestrzenna
x = np.linspace(0, L, Nx)

# Warunek początkowy (dwa piki Gaussa)
sigma = 0.05
u0 = 0.6 * np.exp(-(x - 0.3)**2 / (2 * sigma**2)) + \
     0.8 * np.exp(-(x - 0.7)**2 / (2 * sigma**2))

# Macierz do przechowania całego rozwiązania (Nt x Nx)
U = np.zeros((Nt, Nx))
U[0, :] = u0

# ========== ROZWIĄZYWANIE ==========
u = u0.copy()
for n in range(Nt - 1):
    u_new = np.zeros(Nx)
    # Punkty wewnętrzne
    for i in range(1, Nx - 1):
        u_new[i] = u[i] + r * (u[i-1] - 2*u[i] + u[i+1])
    # Warunki brzegowe Dirichleta
    u_new[0] = 0.0
    u_new[-1] = 0.0
    u = u_new
    U[n+1, :] = u

# ========== STATYCZNY WYKRES (kilka chwil) ==========
plt.figure(figsize=(10, 5))
time_indices = [0, Nt//10, Nt//5, Nt//4, Nt//2, Nt-1]
for idx in time_indices:
    t_actual = idx * dt
    plt.plot(x, U[idx, :], label=f't = {t_actual:.3f} s')
plt.xlabel('x [m]')
plt.ylabel('Temperatura u(x,t)')
plt.title('Równanie ciepła – profile w wybranych chwilach')
plt.legend()
plt.grid(True)
plt.savefig('heat_equation_profiles.png', dpi=300)
plt.show()

# ========== ANIMACJA ==========
fig, ax = plt.subplots(figsize=(8, 5))
line, = ax.plot(x, U[0, :], lw=2, color='red')
ax.set_xlim(0, L)
ax.set_ylim(0, 1.0)
ax.set_xlabel('x [m]')
ax.set_ylabel('Temperatura u(x,t)')
ax.set_title('Ewolucja temperatury w czasie')
ax.grid(True)
time_text = ax.text(0.02, 0.95, '', transform=ax.transAxes)

def animate(frame):
    line.set_ydata(U[frame, :])
    time_text.set_text(f't = {frame * dt:.3f} s')
    return line, time_text

anim = FuncAnimation(fig, animate, frames=Nt, interval=20, blit=True)

# Wyświetlenie animacji (w notebooku lub w oknie)
plt.show()

anim.save('heat_equation_animation.mp4', writer='ffmpeg', fps=30)
