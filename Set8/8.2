# exercise_8_2.py
import numpy as np

# (a) Dowolny jednowymiarowy wektor v1
v1 = np.array([10, 20, 30, 40, 50, 60, 70, 80])
print("(a) v1 =", v1)
print("-" * 50)

# (b) v2 – elementy z nieparzystych indeksów (widok)
v2 = v1[1::2]          # Python: start=1, step=2
print("(b) v2 (nieparzyste indeksy) =", v2)
print("-" * 50)

# (c) v3 – odwrotna kolejność (widok)
v3 = v1[::-1]          # step = -1 odwraca wektor
print("(c) v3 (odwrócony) =", v3)
